# Polymorphism Example

class Dog:
    def sound(self):
        print("Dog barks.")

class Cat:
    def sound(self):
        print("Cat meows.")

class Cow:
    def sound(self):
        print("Cow moos.")

# Create objects
dog = Dog()
cat = Cat()
cow = Cow()

# Demonstrate polymorphism
dog.sound()
cat.sound()
cow.sound()